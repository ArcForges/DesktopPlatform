<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>ArcForges.Native.Otio.Runtime.win-x64</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NativePayloadRoot>$(MSBuildThisFileDirectory)../../../artifacts/native-packages/ArcForges.Native.Otio.Runtime.win-x64</NativePayloadRoot>
    <Description>Windows x64 ArcSlateOtioNative existing ABI, native dependency closure, headers and provenance.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(NativePayloadRoot)/**/*" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="RequireVerifiedNativePayload" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(NativePayloadRoot)/native-manifest.json')" Text="Build and verify the native artifact before packing ArcForges.Native.Otio.Runtime.win-x64." />
  </Target>
</Project>
