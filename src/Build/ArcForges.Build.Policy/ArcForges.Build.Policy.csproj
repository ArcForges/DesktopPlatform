<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>ArcForges.Build.Policy</PackageId>
    <Description>Portable C# 14/15 build policy and central NuGet version enforcement for ArcForges repositories.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Architecture/**/*.cs" />
    <None Include="Architecture/*.cs" Pack="true" PackagePath="tools/architecture/" />
    <None Remove="Architecture/*.props" />
    <None Include="Architecture/*.props" Pack="true" PackagePath="tools/architecture/" />
    <None Remove="Architecture/banned-api-categories.json" />
    <None Include="Architecture/banned-api-categories.json" Pack="true" PackagePath="tools/architecture/" />
    <None Include="build/*" Pack="true" PackagePath="build/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../../NOTICE.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <PropertyGroup>
    <LicenceBoundary>AGPL</LicenceBoundary>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
</Project>
