  <!--
    Parent-bound helper scaffold. Current architecture 27 assigns its Native AOT runtime
    to DesktopPlatform. The retained five-RID bootstrap is not proof of complete
    containment or platform support; WP11/13 own the full helper capability.
  -->
  <Import Project="..\..\..\eng\build\desktop-aot.props" />
  <Import Project="..\..\..\eng\build\desktop-rids.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ArcForges.ContentSandbox</AssemblyName>
    <RootNamespace>ArcForges.ContentSandbox</RootNamespace>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\ArcForges.Desktop.RichContent\ArcForges.Desktop.RichContent.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\ArcForges.Foundation\ArcForges.Foundation.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\ArcForges.NativeInterop\ArcForges.NativeInterop.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <LicenceBoundary>AGPL</LicenceBoundary>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
</Project>
