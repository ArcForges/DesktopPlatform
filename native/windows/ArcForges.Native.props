<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ArcForgesRepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\'))</ArcForgesRepositoryRoot>
    <VcpkgInstalledDir Condition="'$(Platform)' == 'x64'">$(ArcForgesRepositoryRoot)artifacts\vcpkg-installed\</VcpkgInstalledDir>
    <ArcForgesTargetRid Condition="'$(Platform)' == 'x64'">win-x64</ArcForgesTargetRid>
    <ArcForgesTargetRid Condition="'$(Platform)' == 'ARM64'">win-arm64</ArcForgesTargetRid>
    <OutDir>$(ArcForgesRepositoryRoot)artifacts\msbuild\native\$(ArcForgesTargetRid)\$(Configuration)\</OutDir>
    <IntDir>$(ArcForgesRepositoryRoot)artifacts\obj\msbuild\native\$(MSBuildProjectName)\$(ArcForgesTargetRid)\$(Configuration)\</IntDir>
    <TargetName>$(ProjectName)</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ArcForgesRepositoryRoot)native\shared\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions Condition="'$(VcpkgUseStatic)' != 'true'">ARCFORGES_RUNTIME_SHARED_GRAPH=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(VcpkgUseStatic)' == 'true'">ARCFORGES_SHIM_STATIC_GRAPH=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link Condition="'$(VcpkgUseStatic)' == 'true'">
      <AdditionalDependencies>bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
