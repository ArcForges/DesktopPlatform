<Project>
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <VCToolsVersion Condition="'$(MSBuildProjectExtension)' == '.vcxproj' and '$(Platform)' == 'x64'">14.51.36231</VCToolsVersion>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <NeutralLanguage>en-US</NeutralLanguage>
    <IsPackable>false</IsPackable>
    <Authors>ArcForges</Authors>
    <Company>ArcForges</Company>
    <Copyright>Copyright ArcForges contributors</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ArcForges/DesktopPlatform</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/ArcForges/DesktopPlatform</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1605;IL2026;IL3050</WarningsAsErrors>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ArcForgesBuildHost Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</ArcForgesBuildHost>
    <ArcForgesBuildHost Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</ArcForgesBuildHost>
    <ArcForgesBuildHost Condition="$([MSBuild]::IsOSPlatform('OSX'))">macos</ArcForgesBuildHost>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts/bin/dotnet/$(ArcForgesBuildHost)/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts/obj/dotnet/$(ArcForgesBuildHost)/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <!-- Keep both legacy project-local output and repository-scoped output out of SDK source globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**;$(MSBuildThisFileDirectory)artifacts/**</DefaultItemExcludes>
    <DefaultExcludesInProjectFolder>$(DefaultExcludesInProjectFolder);**/bin/**;**/obj/**;$(MSBuildThisFileDirectory)artifacts/**</DefaultExcludesInProjectFolder>
  </PropertyGroup>

  <Import Project="src/Build/ArcForges.Build.Policy/build/ArcForges.Build.Policy.props" />
</Project>
