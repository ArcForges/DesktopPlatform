<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!-- The OS secret-store integration tier (ArcForges-Design 16-testing-strategy section 1): the only tests that reach a real OS
       secret store. No default suite, host verification step or other workflow selects this project (ArchitectureTests enforce it); it runs
       only through its own hosted workflow (.github/workflows/os-secret-store-tier.yml) or eng/os_secret_store_tier.py, with
       ARCFORGES_OS_SECRET_STORE_TESTS=1 set for that run alone. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <LicenceBoundary>AGPL</LicenceBoundary>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="../../src/BuildingBlocks/ArcForges.Security.Secrets/ArcForges.Security.Secrets.csproj" />
  </ItemGroup>
</Project>
